import pygame
import random
import sys

pygame.init()

# ขนาดหน้าจอ
WIDTH = 800
HEIGHT = 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Collect the Stars")

# สี
WHITE = (255,255,255)
BLUE = (0,0,255)
RED = (255,0,0)
YELLOW = (255,255,0)
BLACK = (0,0,0)

# ตัวละคร
player_size = 50
player_x = WIDTH // 2
player_y = HEIGHT // 2
player_speed = 5

# ดาว (ของที่ต้องเก็บ)
star_size = 30
star_x = random.randint(0, WIDTH-star_size)
star_y = random.randint(0, HEIGHT-star_size)

# ศัตรู
enemy_size = 50
enemy_x = random.randint(0, WIDTH-enemy_size)
enemy_y = random.randint(0, HEIGHT-enemy_size)
enemy_speed = 3

score = 0
font = pygame.font.SysFont(None, 40)
clock = pygame.time.Clock()

running = True
game_over = False

while running:
    clock.tick(60)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    if not game_over:
        # ควบคุมตัวละคร
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT]:
            player_x -= player_speed
        if keys[pygame.K_RIGHT]:
            player_x += player_speed
        if keys[pygame.K_UP]:
            player_y -= player_speed
        if keys[pygame.K_DOWN]:
            player_y += player_speed

        # ศัตรูเดินลง
        enemy_y += enemy_speed
        if enemy_y > HEIGHT:
            enemy_y = 0
            enemy_x = random.randint(0, WIDTH-enemy_size)

        # ตรวจจับเก็บดาว
        if (player_x < star_x + star_size and
            player_x + player_size > star_x and
            player_y < star_y + star_size and
            player_y + player_size > star_y):
            
            score += 1
            star_x = random.randint(0, WIDTH-star_size)
            star_y = random.randint(0, HEIGHT-star_size)

        # ตรวจจับชนศัตรู
        if (player_x < enemy_x + enemy_size and
            player_x + player_size > enemy_x and
            player_y < enemy_y + enemy_size and
            player_y + player_size > enemy_y):
            
            game_over = True

    # วาดหน้าจอ
    screen.fill(WHITE)

    if not game_over:
        pygame.draw.rect(screen, BLUE, (player_x, player_y, player_size, player_size))
        pygame.draw.rect(screen, YELLOW, (star_x, star_y, star_size, star_size))
        pygame.draw.rect(screen, RED, (enemy_x, enemy_y, enemy_size, enemy_size))

        score_text = font.render("Score: " + str(score), True, BLACK)
        screen.blit(score_text, (10, 10))
    else:
        over_text = font.render("GAME OVER! Score: " + str(score), True, RED)
        screen.blit(over_text, (200, 300))

    pygame.display.update()

pygame.quit()
sys.exit()
